# Compliance Workspace - Git Ignore

# UAT and archived test data
/uat/
/uat-backup-before-release-*/
/temp-smoke-*/
/temp-fresh-*/
/temp-portability-sandbox-*/

# Generated release packages
/release/

# Runtime application data
/data/
/backups/
/exports/

# SQLite databases
*.db
*.db-*
*.sqlite
*.sqlite3

# Executables and archives
*.exe
*.zip
*.syso

# AI instructions and internal planning/checklist documents
AGENTS.md
docs/implementation_plan_*.md
docs/UAT_CHECKLIST_*.md

# Logs and temporary files
*.log
*.tmp

# Credentials and sensitive files
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Operating system artifacts
Thumbs.db
.DS_Store

# Editor and IDE configurations
.vscode/
.idea/
